+// The Xenon convention, measured from Microsoft's own compiled code.
+//
+// Every argument owns exactly one eight byte slot, starting just above the 16 byte
+// linkage area, whatever its type. Arguments one to eight also have a register: an
+// integer uses the general register that shares its slot, a float or double uses the
+// next free floating point register but still consumes its slot, so the general
+// register sharing it is skipped. D3DDevice_Clear in the XDK's d3d9.lib shows this
+// directly: its sixth argument is a float, and its seventh arrives in r9 rather than
+// r8. ClearSurface in the same object shows the float itself arriving in f1 even
+// though it is the ninth argument, so floating point registers run sequentially.
+//
+// Beyond the eighth slot the value is in memory. A scalar sits at the end of its slot,
+// which is what a callee spilling a 64 bit register with std leaves behind on a big
+// endian machine; ClearSurface homes its fourth argument with `stw r6, caller_sp+44`,
+// four bytes into the eight byte slot at +40. Aggregates larger than a slot, or whose
+// size is not a power of two, are left justified instead. That is the rule the XDK's
+// own vadefs.h states as _VA_IS_LEFT_JUSTIFIED.
+//
+// Known gap: a 64 bit integer reaches this hook already split into two i32 pieces, so
+// it takes two slots where Microsoft's compiler uses one 64 bit register and one slot.
+static bool CC_PPC32_Xenon(unsigned &ValNo, MVT &ValVT, MVT &LocVT,
+                           CCValAssign::LocInfo &LocInfo,
+                           ISD::ArgFlagsTy &ArgFlags, CCState &State) {
+  static const MCPhysReg GPRs[] = {PPC::R3, PPC::R4, PPC::R5, PPC::R6,
+                                   PPC::R7, PPC::R8, PPC::R9, PPC::R10};
+  // f1 through f13. Nothing below f14 ever appears in the XDK's __savefpr helpers,
+  // so f0-f13 are volatile and all of f1-f13 can carry arguments.
+  static const MCPhysReg FPRs[] = {PPC::F1, PPC::F2, PPC::F3,  PPC::F4,  PPC::F5,
+                                   PPC::F6, PPC::F7, PPC::F8,  PPC::F9,  PPC::F10,
+                                   PPC::F11, PPC::F12, PPC::F13};
+  const unsigned SlotSize = 8;
+  const unsigned LinkageSize = 16;
+
+  unsigned Size = LocVT.getStoreSize();
+  unsigned Alloc = (Size + SlotSize - 1) & ~(SlotSize - 1);
+  if (Alloc < SlotSize)
+    Alloc = SlotSize;
+
+  // The slot cursor is the stack size itself, so a register argument still burns its
+  // slot and the caller's home area stays in step with the register numbering.
+  unsigned Offset = State.AllocateStack(Alloc, Align(SlotSize));
+  unsigned Slot = (Offset - LinkageSize) / SlotSize;
+
+  if (LocVT == MVT::f32 || LocVT == MVT::f64) {
+    // A floating point argument takes a floating point register whatever slot it
+    // landed in, not just within the first eight: ClearSurface in the XDK's d3d9.lib
+    // receives its ninth argument, a float, in f1. It consumes its slot either way,
+    // so the general register sharing that slot is skipped.
+    if (Slot < std::size(GPRs))
+      State.AllocateReg(GPRs[Slot]);
+    if (MCRegister FPR = State.AllocateReg(FPRs)) {
+      State.addLoc(CCValAssign::getReg(ValNo, ValVT, FPR, LocVT, LocInfo));
+      return true;
+    }
+  } else if (Slot < std::size(GPRs)) {
+    if (MCRegister GPR = State.AllocateReg(GPRs[Slot])) {
+      State.addLoc(CCValAssign::getReg(ValNo, ValVT, GPR, LocVT, LocInfo));
+      return true;
+    }
+  }
+
+  bool LeftJustified = Size > SlotSize || (Size & (Size - 1)) != 0;
+  if (!LeftJustified && Size < SlotSize)
+    Offset += SlotSize - Size;
+
+  State.addLoc(CCValAssign::getMem(ValNo, ValVT, Offset, LocVT, LocInfo));
+  return true;
+}
