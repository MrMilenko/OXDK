+// Arguments under the Xbox 360 convention, as Microsoft's compiler passes them.
+//
+// A char, short or bool is passed as is: Microsoft's callers do not extend
+// them, so the callee must, and leaving off signext/zeroext makes ours do so.
+// Our caller extending anyway costs nothing and a Microsoft callee ignores it.
+//
+// An aggregate of up to eight bytes travels as its bytes in one general
+// register and its slot, never a floating point register: 1, 2 and 4 bytes
+// right justified, any other size left justified from the slot's first byte.
+// Coercing to an integer of the same size, or to i64 for the odd sizes, does
+// exactly that on a big endian target, and i64 already takes one register and
+// one slot under xenon-abi. Larger aggregates keep the SVR4 treatment (a
+// pointer to a copy), which Microsoft's code does not share; see
+// llvm/README.md.
+ABIArgInfo PPC32_SVR4_ABIInfo::classifyXenonArgumentType(QualType Ty) const {
+  Ty = useFirstFieldIfTransparentUnion(Ty);
+  if (isAggregateTypeForABI(Ty) &&
+      !getRecordArgABI(Ty, getCXXABI()) && !Ty->isAnyComplexType()) {
+    uint64_t Size = getContext().getTypeSize(Ty);
+    if (Size == 0)
+      return ABIArgInfo::getIgnore();
+    if (Size <= 64) {
+      unsigned Bits = (Size == 8 || Size == 16 || Size == 32) ? Size : 64;
+      return ABIArgInfo::getDirect(llvm::Type::getIntNTy(getVMContext(), Bits));
+    }
+  }
+  if (!isAggregateTypeForABI(Ty) && isPromotableIntegerTypeForABI(Ty) &&
+      !Ty->isBitIntType())
+    return ABIArgInfo::getDirect();
+  return classifyArgumentType(Ty);
+}
