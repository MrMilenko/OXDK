+// Microsoft's Xbox 360 compiler treats all 64 bits of r14-r31 as nonvolatile,
+// even in titles with 32 bit pointers, and its code keeps 64 bit integers in
+// them across calls. A Xenon save or restore of one of them therefore moves the
+// whole doubleword (std/ld on the containing X register); a word store would
+// hand the caller back a zero upper half.
+static bool isXenonWideGPR(const PPCSubtarget &STI, MCRegister Reg) {
+  return STI.isXenonABI() && !STI.isPPC64() &&
+         PPC::GPRCRegClass.contains(Reg) && Reg != PPC::ZERO;
+}
+
+static MCRegister getXenonWideGPR(const PPCSubtarget &STI, MCRegister Reg) {
+  return STI.getRegisterInfo()->getMatchingSuperReg(Reg, PPC::sub_32,
+                                                    &PPC::G8RCRegClass);
+}
+
+// Save GPR Reg at Off(Base) in the prologue: stw normally, std of the whole
+// register under Xenon. The X register is an undef use because a 32 bit
+// subtarget models only its low word; the implicit use of Reg keeps the store
+// after the last write of the register it saves.
+static void buildGPRSave(const PPCSubtarget &STI, MachineBasicBlock &MBB,
+                         MachineBasicBlock::iterator MBBI, const DebugLoc &dl,
+                         const MCInstrDesc &StoreInst, MCRegister Reg,
+                         unsigned KillFlag, int64_t Off, MCRegister Base) {
+  const PPCInstrInfo &TII = *STI.getInstrInfo();
+  if (!isXenonWideGPR(STI, Reg)) {
+    BuildMI(MBB, MBBI, dl, StoreInst)
+        .addReg(Reg, KillFlag)
+        .addImm(Off)
+        .addReg(Base);
+    return;
+  }
+  BuildMI(MBB, MBBI, dl, TII.get(PPC::STD))
+      .addReg(getXenonWideGPR(STI, Reg), RegState::Undef)
+      .addImm(Off)
+      .addReg(Base)
+      .addReg(Reg, RegState::Implicit | KillFlag);
+}
+
+// The same through stwx/stdx, for a base that has to be an index register.
+static void buildGPRSaveIdx(const PPCSubtarget &STI, MachineBasicBlock &MBB,
+                            MachineBasicBlock::iterator MBBI,
+                            const DebugLoc &dl, MCRegister Reg,
+                            MCRegister Index) {
+  const PPCInstrInfo &TII = *STI.getInstrInfo();
+  if (!isXenonWideGPR(STI, Reg)) {
+    BuildMI(MBB, MBBI, dl, TII.get(PPC::STWX))
+        .addReg(Reg, RegState::Kill)
+        .addReg(PPC::ZERO)
+        .addReg(Index);
+    return;
+  }
+  BuildMI(MBB, MBBI, dl, TII.get(PPC::STDX))
+      .addReg(getXenonWideGPR(STI, Reg), RegState::Undef)
+      .addReg(PPC::ZERO)
+      .addReg(Index)
+      .addReg(Reg, RegState::Implicit | RegState::Kill);
+}
+
+// Restore GPR Dst from Off(Base) in the epilogue: lwz normally, ld of the
+// whole register under Xenon.
+static void buildGPRRestore(const PPCSubtarget &STI, MachineBasicBlock &MBB,
+                            MachineBasicBlock::iterator MBBI,
+                            const DebugLoc &dl, const MCInstrDesc &LoadInst,
+                            MCRegister Dst, int64_t Off, MCRegister Base) {
+  const PPCInstrInfo &TII = *STI.getInstrInfo();
+  if (!isXenonWideGPR(STI, Dst)) {
+    BuildMI(MBB, MBBI, dl, LoadInst, Dst).addImm(Off).addReg(Base);
+    return;
+  }
+  BuildMI(MBB, MBBI, dl, TII.get(PPC::LD), getXenonWideGPR(STI, Dst))
+      .addImm(Off)
+      .addReg(Base);
+}
